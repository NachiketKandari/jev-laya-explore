# The uv-managed environment; rebuild with `uv sync --frozen`.
.venv/

# Python bytecode
__pycache__/
*.pyc

.DS_Store

# Agent tooling scratch directory
.freebuff/

# Upstream reference clone (read-only, ships its own .git, so adding it would create a
# broken gitlink). Reproduce with:
#   git clone https://github.com/githubnext/localjev
# Nothing in this project imports it.
localjev/

# Large vendored blobs below are NOT pushed (GitHub 100MB/file cap).
# Re-fetch locally: `uv run scripts/fetch_models.py` (+ train split notes in
# README "Committing 3.2 GB of weights"). Nothing pushed yet depends on them.
models/
vendor/wheels/*.whl
# (SHA256SUMS stays tracked as the manifest; rebuild the house with
#  `uv pip download -r requirements.txt -d vendor/wheels --only-binary=:all:`)

# Local training outputs: reports (*.json) are committed, weight files are not
# (~100MB each -- over GitHub's 100MB/file cap). Reproduce with
# `uv run scripts/train_laya_local.py --stage head`.
training/heads/*.pt

# ---------------------------------------------------------------------------
# Large blobs below stay OUT of the pushed history (GitHub 100MB/file cap).
# Re-fetch locally: `uv run scripts/fetch_models.py` (weights) and
# `uv sync --frozen` (env). What IS tracked for reproducibility:
#   uv.lock                  resolved dependency graph behind `uv sync --frozen`
#   requirements.txt         flat pin list (input for the wheelhouse download)
#   vendor/wheels/SHA256SUMS manifest of the 38-wheel house (blobs excluded)
# See README.md "Weights and wheels are fetched, not committed".
# ---------------------------------------------------------------------------
